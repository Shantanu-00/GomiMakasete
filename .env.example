# ==============================================================================
# GomiMakasete Environment Parameter Dictionary
# Copy this file to .env and configure for your AWS account & local dev
# DO NOT COMMIT SECRETS OR ACCESS KEYS TO VERSION CONTROL
# ==============================================================================

# AWS Region & Identity
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Amazon Bedrock Foundation Model IDs (September 2026 Fleet)
BEDROCK_TIER1_VISION_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_TIER2_REASONING_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_SONIC_MODEL_ID=amazon.nova-sonic-v1:0

# Amazon Bedrock AgentCore Runtime
BEDROCK_AGENTCORE_RUNTIME_ENDPOINT=http://localhost:8080/invocations
AGENTCORE_RUNTIME_PORT=8080
AGENTCORE_RUNTIME_HOST=0.0.0.0

# Amazon Bedrock Knowledge Base (AOSS Vector Search)
BEDROCK_KNOWLEDGE_BASE_ID=your-bedrock-kb-id-here

# Amazon DynamoDB Tables
DYNAMODB_SCHEDULE_TABLE=GomiSchedules
DYNAMODB_SESSION_TABLE=GomiAgentSessions

# Amazon S3 Ingestion Bucket
S3_INGESTION_BUCKET_NAME=gomimakasete-uploads-bucket

# Local Testing & Mock Flags
USE_LOCAL_MOCKS=true
SEED_AWS_DYNAMODB=false
LOG_LEVEL=INFO
